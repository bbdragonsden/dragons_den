{
  "functions": {
    "api/waitlist.js":    { "memory": 256, "maxDuration": 10 },
    "api/login.js":       { "memory": 256, "maxDuration": 10 },
    "api/verify.js":      { "memory": 256, "maxDuration": 10 },
    "api/assign-pack.js": { "memory": 256, "maxDuration": 15 },
    "api/admin-data.js":  { "memory": 256, "maxDuration": 15 },
    "api/admin-action.js":{ "memory": 256, "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
