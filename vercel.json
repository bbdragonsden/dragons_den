{
  "functions": {
    "api/waitlist.js":    { "memory": 256, "maxDuration": 10 },
    "api/inscripcion.js": { "memory": 256, "maxDuration": 10 },
    "api/login.js":       { "memory": 256, "maxDuration": 10 },
    "api/verify.js":      { "memory": 256, "maxDuration": 10 },
    "api/assign-pack.js": { "memory": 256, "maxDuration": 15 },
    "api/admin-data.js":  { "memory": 256, "maxDuration": 15 },
    "api/admin-action.js":{ "memory": 256, "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy",   "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://oyuhyrzjhaqzawwnmwcv.supabase.co wss://oyuhyrzjhaqzawwnmwcv.supabase.co; frame-src https://www.youtube-nocookie.com https://www.youtube.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
